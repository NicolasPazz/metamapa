# ============================================
# Archivo de ejemplo para variables de entorno PRODUCCIÃ“N
# ============================================
# Copia este archivo a .env.prod y completa con tus valores reales
# Este archivo NO debe contener datos sensibles reales
# NUNCA commitees el archivo .env.prod al repositorio
#
# Uso: cp .env.prod.example .env.prod

# ============================================
# Base de Datos RDS (AWS)
# ============================================
# Endpoint de la instancia RDS (sin el puerto)
RDS_HOST=ejemplo-instancia.region.rds.amazonaws.com

# Puerto de RDS (por defecto 3306)
RDS_PORT=3306

# Usuario de la base de datos RDS
RDS_USERNAME=admin_ejemplo

# ContraseÃ±a del usuario de RDS
RDS_PASSWORD=password_rds_ejemplo_seguro

# ============================================
# ConfiguraciÃ³n de Base de Datos
# ============================================
# Habilitar SSL para conexiones a RDS (true/false)
# En producciÃ³n siempre debe ser 'true'
DB_USE_SSL=true

# Estrategia de DDL de Hibernate (update, validate, create, create-drop)
# En producciÃ³n normalmente se usa 'validate' o 'none'
# Usar 'update' solo en la primera ejecuciÃ³n
DDL_AUTO=validate

# ============================================
# Servicio Users
# ============================================
# Credenciales del usuario administrador
ADMIN_USERNAME=admin_produccion_ejemplo
ADMIN_PASSWORD=password_admin_produccion_ejemplo_seguro

# ============================================
# Servicio Proxy ONG
# ============================================
# Credenciales para autenticaciÃ³n con la API externa de ONG
PROXY_ONG_EMAIL=ejemplo_produccion@email.com
PROXY_ONG_PASSWORD=password_ong_produccion_ejemplo
PROXY_ONG_API_URL=https://api-produccion-ejemplo.disilab.ar/public/api

# ============================================
# Servicio Frontend
# ============================================
# URL del frontend (usado por dinamica para notificaciones)
FRONTEND_URL=https://metamapa-dds.ddns.net

# TamaÃ±o de pÃ¡gina para paginaciÃ³n
PAGINATION_PAGE_SIZE=18

# Perfil de Spring activo
SPRING_PROFILES_ACTIVE=prod

# ============================================
# Certbot (Let's Encrypt)
# ============================================
# Email para notificaciones de Let's Encrypt
CERTBOT_EMAIL=ejemplo@email.com

# Dominio para el certificado SSL
CERTBOT_DOMAIN=metamapa-dds.ddns.net