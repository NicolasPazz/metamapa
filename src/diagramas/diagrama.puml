@startuml

class Hecho {
    -titulo: String
    -descripcion: String
    -categoria: Categoria
    -latitud: Double
    -longitud: Double
    -fecha: LocalDateTime
    -origen: OrigenHecho
    -estado: EstadoHecho
    -contribuyente: Contribuyente

    +esDuplicadoDe(hecho: Hecho): Boolean
    +marcarComoOculto(): void
}

class Categoria {
    -nombre: String
}

enum OrigenHecho {
    DATASET
    MANUAL
    CONTRIBUYENTE
}

enum EstadoHecho{
    PUBLICADO
    OCULTADO
}

class Coleccion {
    -titulo: String
    -descripcion: String
    -fuente: Fuente
    -criterioDePertenencia: Criterio

    +obtenerHechos(): List<Hecho>
}

interface Criterio {
    +cumple(hecho: Hecho): Boolean
}
class CriterioCategoria {
    -categoria: Categoria
}
class CriterioPais {
    -pais: String
}
class CriterioFecha {
    -fechaDesde: LocalDateTime
    -fechaHasta: LocalDateTime
}

abstract Fuente {
    -hechos: List<Hecho>

    +importarHechos(): List<Hecho>
}
class FuenteEstatica {
    -archivo: String
}
class FuenteDinamica
class FuenteProxy

class SolicitudDeEliminacion {
    -hecho: Hecho
    -textoFundamentos: String
    -fecha: LocalDateTime
    -estado: EstadoSolicitud

    +aceptar(): void
    +rechazar(): void
}

enum EstadoSolicitud {
    PENDIENTE
    ACEPTADA
    RECHAZADA
}

class Contribuyente {
    -nombre: String
    -apellido: String
    -edad: Integer

    +subir(hecho: Hecho): void
    +solicitarEliminacion(hecho: Hecho, fundamentos: String): SolicitudDeEliminacion
}

class Administrador {
    +crearColeccion(coleccion: Coleccion): void
    +aceptarSolicitud(solicitud: SolicitudDeEliminacion): void
    +rechazarSolicitud(solicitud: SolicitudDeEliminacion): void
}

Hecho --> Contribuyente
Hecho --> OrigenHecho
Hecho --> Categoria
Hecho --> EstadoHecho

Fuente -->"*" Hecho
Fuente <|-- FuenteEstatica
Fuente <|-- FuenteDinamica
Fuente <|-- FuenteProxy

Criterio <|.. CriterioCategoria
Criterio <|.. CriterioPais
Criterio <|.. CriterioFecha

Coleccion --> Fuente
Coleccion --> Criterio

SolicitudDeEliminacion --> Hecho
SolicitudDeEliminacion --> EstadoSolicitud

Administrador ..> Coleccion
Administrador ..> SolicitudDeEliminacion

@enduml
