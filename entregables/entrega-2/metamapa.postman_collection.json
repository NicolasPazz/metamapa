						{
							"name": "http://localhost:8083/api/hechos/nuevos",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"// Parseamos el body como JSON\r",
											"let hechos = pm.response.json();\r",
											"\r",
											"// Total de hechos\r",
											"let total = hechos.length;\r",
											"\r",
											"// Inicializamos el contador por origen según tu enum\r",
											"let counts = {\r",
											"  DATASET: 0,\r",
											"  ONG: 0,\r",
											"  METAMAPA: 0,\r",
											"  CONTRIBUYENTE: 0,\r",
											"  MANUAL: 0\r",
											"};\r",
											"\r",
											"// Recorremos y contamos\r",
											"hechos.forEach(h => {\r",
											"  let o = h.origen;\r",
											"  if (counts.hasOwnProperty(o)) {\r",
											"    counts[o]++;\r",
											"  } else {\r",
											"    // opcional: para orígenes inesperados\r",
											"    console.warn(`Origen desconocido: ${o}`);\r",
											"  }\r",
											"});\r",
											"\r",
											"// Mostramos en consola\r",
											"console.log(`Total hechos: ${total}`);\r",
											"Object.entries(counts).forEach(([origen, cnt]) => {\r",
											"  console.log(`${origen}: ${cnt}`);\r",
											"});\r",
											"\r",
											"// (Opcional) Guardamos en variables de entorno\r",
											"pm.environment.set(\"totalHechos\", total);\r",
											"Object.entries(counts).forEach(([origen, cnt]) => {\r",
											"  pm.environment.set(`hechos_${origen}`, cnt);\r",
											"});\r",
											""
										],
										"type": "text/javascript",
										"packages": {}
									}
								}
							],
