@startuml
hide circle
skinparam linetype ortho

entity "COLECCION" as cole {
  handle : VARCHAR(100) <<PK>>
  --
  titulo : VARCHAR(255)
}

entity "CATEGORIA" as cat {
  id : BIGINT <<PK>>
  --
  nombre : VARCHAR(255)
}

entity "CATEGORIA_HORA" as s_ch {
  id: BIGINT <<PK>>
  categoria_id : BIGINT <<FK>>
  --
  hora : INTEGER(2)
  cantidad_hechos : BIGINT
}

entity "PROVINCIA" as prov {
  id : BIGINT <<PK>>
  --
  nombre : VARCHAR(100)
}

entity "SOLICITUD" as sol {
  id : BIGINT <<PK>>
  --
  spam : BOOLEAN
}

' Tablas intermedias
entity "COLECCION_PROVINCIA" as s_cp {
  id: BIGINT <<PK>>
  coleccion_handle : VARCHAR(100) <<FK>>
  provincia_id : BIGINT <<FK>>
  --
  cantidad_hechos : BIGINT
}

entity "CATEGORIA_PROVINCIA" as s_cpr {
  id: BIGINT <<PK>>
  categoria_id : BIGINT <<FK>>
  provincia_id : BIGINT <<FK>>
  --
  cantidad_hechos : BIGINT
}

cole ||--o{ s_cp
prov ||--o{ s_cp

cat  ||--o{ s_cpr
prov ||--o{ s_cpr

cat  ||--o{ s_ch
@enduml
