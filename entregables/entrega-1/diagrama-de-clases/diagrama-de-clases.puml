// IMPORTANTE: actualizar la url en la previsualizacion si se modifica el .puml

@startuml
class Hecho {
    -data: DataHecho
    -origen: OrigenHecho
    -estado: EstadoHecho
    -contribuyente: Contribuyente
    -etiquetas: Set<String>
    -contenidoMultimedia: ContenidoMultimedia

    +esDuplicadoDe(otroHecho: Hecho): Boolean
    +ocultar(): void
    +esVisible(): Boolean
    +agregarEtiqueta(etiqueta: String): void
    +contieneEtiqueta(etiqueta: String): Boolean
}

class ContenidoMultimedia{
   -tipoContenido: TipoContenido
   -rutaAcceso: String
}

enum TipoContenido{
   IMAGEN
   VIDEO
}

class DataHecho {
    -titulo: String
    -descripcion: String
    -categoria: String
    -latitud: Double
    -longitud: Double
    -fechaDeAcontecimiento: LocalDate
    -fechaDeCarga: LocalDate
}

enum OrigenHecho {
    DATASET
    MANUAL
    CONTRIBUYENTE
}

enum EstadoHecho{
    VISIBLE
    OCULTO
}

class Coleccion {
    -titulo: String
    -descripcion: String
    -fuente: Fuente
    -criterioDePertenencia: Criterio

    +importarHechosVisibles(): List<Hecho>
    +obtenerHechos(): List<Hecho>
}

interface Criterio {
    +cumple(hecho: Hecho): Boolean
}
class CriterioCategoria {
    -categoria: String
    +cumple(hecho: Hecho): Boolean
}
class CriterioCombinado {
    -criterios: List<Criterio>
    +cumple(hecho: Hecho): Boolean
    +agregarCriterio(criterio: Criterio): void
}
class CriterioDescripcion {
    -descripcion: String
    +cumple(hecho: Hecho): Boolean
}
class CriterioFechas {
    -fechaInicial: LocalDate
    -fechaFinal: LocalDate
    -tipoFecha: TipoFecha
    +cumple(hecho: Hecho): Boolean
}
class CriterioLugar {
    -lat: Double
    -lng: Double
    +cumple(hecho: Hecho): Boolean
}
class CriterioTitulo {
    -titulo: String
    +cumple(hecho: Hecho): Boolean
}
class CriterioOrigen {
    -origen: OrigenHecho
    +cumple(hecho: Hecho): Boolean
}

enum TipoFecha {
    CARGA
    ACONTECIMIENTO
}

abstract Fuente {
    +importarHechos(): List<Hecho>
    +abrirFuente(): void
    +cerrarFuente(): void
}
class FuenteEstatica {
    -rutaArchivo: String
    -lector: FileReader
}
class FuenteDinamica {
    -hechos: List<Hecho>
}
class FuenteProxy

class SolicitudDeEliminacion {
    -hecho: Hecho
    -textoFundamentos: String
    -fecha: LocalDate
    -estado: EstadoSolicitud

    +aceptar(): void
    +rechazar(): void
}

enum EstadoSolicitud {
    PENDIENTE
    ACEPTADA
    RECHAZADA
}

class Contribuyente {
    -nombre: String
    -apellido: String
    -edad: Integer

    +esAnonimo(): Boolean
    +subir(hecho: Hecho): void
    +solicitarEliminacion(hecho: Hecho, fundamentos: String): SolicitudDeEliminacion
}

class Administrador {
    +crearColeccion(titulo: String, descripcion: String, fuente: Fuente, criterioDePertenencia: Criterio): Coleccion
    +aceptarSolicitud(solicitud: SolicitudDeEliminacion): void
    +rechazarSolicitud(solicitud: SolicitudDeEliminacion): void
}


Hecho --> DataHecho
Hecho --> Contribuyente
Hecho --> OrigenHecho
Hecho --> EstadoHecho
Hecho --> ContenidoMultimedia

Fuente <|-- FuenteEstatica
Fuente <|-- FuenteDinamica
Fuente <|-- FuenteProxy

Criterio <|.. CriterioCategoria
Criterio <|.. CriterioCombinado
Criterio <|.. CriterioDescripcion
Criterio <|.. CriterioFechas
Criterio <|.. CriterioLugar
Criterio <|.. CriterioTitulo
Criterio <|.. CriterioOrigen

CriterioFechas --> TipoFecha

Coleccion --> Fuente
Coleccion --> Criterio

FuenteDinamica --> Hecho

SolicitudDeEliminacion --> Hecho
SolicitudDeEliminacion --> EstadoSolicitud

Administrador ..> Coleccion
Administrador ..> SolicitudDeEliminacion

ContenidoMultimedia --> TipoContenido

Contribuyente ..> Hecho

CriterioOrigen --> OrigenHecho

@enduml
