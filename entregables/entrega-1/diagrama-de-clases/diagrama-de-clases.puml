// IMPORTANTE: actualizar la url en la previsualizacion si se modifica el .puml

@startuml
class Hecho {
    -data: DataHecho
    -origen: OrigenHecho
    -estado: EstadoHecho
    -contribuyente: Contribuyente
    -etiquetas: Set<Etiqueta>
    -contenidoMultimedia: List<ContenidoMultimedia>
    -transicionesDeEstado: List<Transicion>

    +esDuplicadoDe(otroHecho: Hecho): Boolean
    +ocultar(): Void
    +esVisible(): Boolean
    +agregarEtiqueta(unaEtiqueta: Etiqueta): Void
    +contieneEtiqueta(unaEtiqueta: Etiqueta): Boolean
}

class Transicion {
    -fecha: LocalDate
    -estadoFinal: EstadoHecho
    -solicitud: SolicitudDeEliminacion
}

class Etiqueta {
    -nombre: String
}

class ContenidoMultimedia{
   -tipoContenido: TipoContenido
   -rutaAcceso: String
}

enum TipoContenido{
   IMAGEN
   VIDEO
   AUDIO
}

class DataHecho {
    -titulo: String
    -descripcion: String
    -categoria: Categoria
    -latitud: Double
    -longitud: Double
    -fechaDeAcontecimiento: LocalDate
    -fechaDeCarga: LocalDate
}

class Categoria {
    -categoria: String
}

enum OrigenHecho {
    DATASET
    MANUAL
    CONTRIBUYENTE
}

enum EstadoHecho{
    VISIBLE
    OCULTO
}

class Coleccion {
    -titulo: String
    -descripcion: String
    -fuente: Fuente
    -criterioDePertenencia: Criterio

    +importarHechosVisibles(): List<Hecho>
    +obtenerHechos(): List<Hecho>
}

interface Criterio {
    +cumple(hecho: Hecho): Boolean
}
class CriterioCategoria {
    -categoria: Categoria
    +cumple(hecho: Hecho): Boolean
}
class CriterioCombinado {
    -criterios: List<Criterio>
    +cumple(hecho: Hecho): Boolean
    +agregarCriterio(criterio: Criterio): Void
}
class CriterioIgualdad {
    -cadenaAComparar: String
    -tipoDeDato: TipoDato
    +cumple(hecho: Hecho): Boolean
}

enum TipoDato {
    TITULO
    DESCRIPCION
}

class CriterioFechas {
    -fechaInicial: LocalDate
    -fechaFinal: LocalDate
    -tipoFecha: TipoFecha
    +cumple(hecho: Hecho): Boolean
}
class CriterioLugar {
    -lat: Double
    -lng: Double
    +cumple(hecho: Hecho): Boolean
}

class CriterioOrigen {
    -origen: OrigenHecho
    +cumple(hecho: Hecho): Boolean
}

enum TipoFecha {
    CARGA
    ACONTECIMIENTO
}

abstract Fuente {
    +importarHechos(): List<Hecho>
    +abrirFuente(): Void
    +cerrarFuente(): Void
}
class FuenteEstatica {
    -rutaArchivo: String
    -lector: FileReader
}

class SolicitudDeEliminacion {
    -hecho: Hecho
    -textoFundamentos: String
    -fecha: LocalDate
    -estado: EstadoSolicitud
    -contribuyente: Contribuyente
    -validaciones: Set<Validacion>

    +aceptar(): Void
    +rechazar(): Void
}

interface Validacion {
    +cumple(solicitud: SolicitudDeEliminacion): Boolean
}

class ValidacionLongitud {
    -int longitud

    +cumple(solicitud: SolicitudDeEliminacion): Boolean
}

enum EstadoSolicitud {
    PENDIENTE
    ACEPTADA
    RECHAZADA
}

class Contribuyente {
    -nombre: String
    -apellido: String
    -fechaDeNacimiento: LocalDate

    +edad(): Int
    +esAnonimo(): Boolean
    +subir(hecho: Hecho): Void
    +solicitarEliminacion(hecho: Hecho, fundamentos: String): SolicitudDeEliminacion
}

Hecho --> DataHecho
Hecho --> Contribuyente
Hecho --> OrigenHecho
Hecho --> EstadoHecho
Hecho --> " * " ContenidoMultimedia
Hecho --> " * "  Etiqueta
Hecho --> " * " Transicion

Fuente <|-- FuenteEstatica

Criterio <|.. CriterioCategoria
Criterio <|.. CriterioCombinado
Criterio <|.. CriterioIgualdad
Criterio <|.. CriterioFechas
Criterio <|.. CriterioLugar
Criterio <|.. CriterioOrigen

CriterioFechas --> TipoFecha
Criterio <-- CriterioCombinado
CriterioCategoria --> Categoria
CriterioIgualdad --> TipoDato
DataHecho --> Categoria

Coleccion --> Fuente
Coleccion --> Criterio

FuenteEstatica ..> Hecho

SolicitudDeEliminacion --> Hecho
SolicitudDeEliminacion --> EstadoSolicitud
SolicitudDeEliminacion --> Contribuyente
SolicitudDeEliminacion --> " * " Validacion
Validacion <|.. ValidacionLongitud

ContenidoMultimedia --> TipoContenido

Contribuyente ..> Hecho

CriterioOrigen --> OrigenHecho

@enduml
