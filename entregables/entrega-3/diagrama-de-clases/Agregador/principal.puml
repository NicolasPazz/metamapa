@startuml
package "agregador" {
    ' ==== INTERFACES ====

    interface Criterio {
        + cumple(Hecho): Boolean
    }

    interface DetectorDeSpam {
        + esSpam(String): Boolean
    }

    interface Validacion {
        + cumple(SolicitudDeEliminacion): Boolean
    }

    ' ==== CLASES ====

    class Categoria {
        - categoria: String
    }

    class Coleccion {
        - criterioDePertenencia: Criterio
        - descripcion: String
        - titulo: String
        - handle: String
        - hechos: List<Hecho>
        - hechosConsensuados: List<Hecho>
        - algoritmoConsenso: AAlgoritmoConsenso

        + setearHechosConsensuados(fuentesTotales: Int): Void
        + getHechos(): List<Hecho>
        + generarHandle(String): String
        + mapToDTO(): ColeccionDTO
        + actualizar(): Void
    }

    Coleccion --> Criterio
    Coleccion --> " * " Hecho

    class ContenidoMultimedia {
        - pathArchivo: String
        - tipoContenido: TipoContenido
    }

    ContenidoMultimedia --> TipoContenido

    class Contribuyente {
        - id: Long
        - apellido: String
        - fechaDeNacimiento: LocalDate
        - nombre: String

        + edad(): Int
        + esAnonimo(): Boolean
    }

    Contribuyente ..> Hecho

    class CriterioCombinado implements Criterio {
        - criterios: List<Criterio>

        + agregarCriterio(Criterio): Void
        + cumple(Hecho): Boolean
    }

    CriterioCombinado --> " * " Criterio

    class CriterioFechas implements Criterio {
        - fechaFinal: LocalDate
        - fechaInicial: LocalDate
        - tipoFecha: TipoFecha

        + cumple(Hecho): Boolean
    }

    CriterioFechas --> TipoFecha

    class CriterioIgualdad implements Criterio {
        - cadenaAComparar: String
        - tipoDeDato: TipoDato

        + cumple(Hecho): Boolean
    }

    CriterioIgualdad --> TipoDato

    class CriterioLugar implements Criterio {
        - lat: Double
        - lng: Double

        + cumple(Hecho): Boolean
    }

    class CriterioOrigen implements Criterio {
        - origen: OrigenHecho

        + cumple(Hecho): Boolean
    }

    CriterioOrigen --> OrigenHecho

    class DataHecho {
        - descripcion: String
        - fechaDeAcontecimiento: LocalDate
        - fechaDeCarga: LocalDate
        - latitud: Double
        - longitud: Double
        - titulo: String
    }

    DataHecho --> Categoria

    class DetectorDeSpamTFIDF implements DetectorDeSpam, Validacion {
        - umbral: Double

        + esValida(String): Boolean
        + esSpam(String): Boolean
    }

    class Etiqueta {
        - nombre: String
    }

    class Hecho {
        - id: Long
        - contenidoMultimedia: List<ContenidoMultimedia>
        - contribuyente: Contribuyente
        - data: DataHecho
        - etiquetas: Set<Etiqueta>
        - estado: EstadoHecho
        - origen: OrigenHecho
        - transicionesDeEstado: List<TransicionEstadoHecho>
        - categoria: Categoria

        + agregarEtiqueta(Etiqueta): Void
        + contieneEtiqueta(Etiqueta): Boolean
        + esDuplicadoDe(Hecho): Boolean
        + esVisible(): Boolean
        + ocultar(): Void
        + esDeCategoria(Categoria): Boolean
        + trancisionarEstado(EstadoHecho): Void
        + mapToDTO(): HechoDTO
    }

    Hecho --> Contribuyente
    Hecho *-- DataHecho
    Hecho --> EstadoHecho
    Hecho --> OrigenHecho
    Hecho --> " * " ContenidoMultimedia
    Hecho --> " * " Etiqueta
    Hecho --> " * " TransicionEstadoHecho
    Hecho --> Categoria

    class SolicitudDeEliminacion {
        - id: Long
        - contribuyente: Contribuyente
        - hecho: Hecho
        - estado: EstadoSolicitud
        - fecha: LocalDate
        - textoFundamentos: String
        - transicionesDeEstado: List<TransicionEstadoSolicitud>
        - validaciones: Set<Validacion>

        + aceptar(): Void
        + rechazar(): Void
        + esValida(String): Boolean
    }

    SolicitudDeEliminacion --> Contribuyente
    SolicitudDeEliminacion --> EstadoSolicitud
    SolicitudDeEliminacion --> Hecho
    SolicitudDeEliminacion --> " * " TransicionEstadoSolicitud
    SolicitudDeEliminacion --> " * " Validacion

    class TransicionEstadoHecho {
        - estadoFinal: EstadoHecho
        - fecha: LocalDate
    }

    TransicionEstadoHecho --> EstadoHecho

    class TransicionEstadoSolicitud {
        - estadoFinal: EstadoSolicitud
        - fecha: LocalDate
    }

    TransicionEstadoSolicitud --> EstadoSolicitud

    class ValidacionLongitud implements Validacion {
        - longitud: Int

        + cumple(SolicitudDeEliminacion): Boolean
    }

    ' ==== ENUMS ====

    enum EstadoHecho {
        OCULTO
        VISIBLE
    }

    enum EstadoSolicitud {
        ACEPTADA
        PENDIENTE
        RECHAZADA
    }

    enum OrigenHecho {
        CONTRIBUYENTE
        DATASET
        MANUAL
    }

    enum TipoContenido {
        AUDIO
        IMAGEN
        VIDEO
    }

    enum TipoDato {
        CATEGORIA
        DESCRIPCION
        ETIQUETA
        TITULO
    }

    enum TipoFecha {
        ACONTECIMIENTO
        CARGA
    }
}
@enduml