@startuml
  class Hecho {
    -id: Long
    -titulo: String
    -descripcion: String
    -categoria: String
    -latitud: Double
    -longitud: Double
    -fechaDeAcontecimiento: LocalDate
    -fechaDeCarga: LocalDateTime
    -ultimaModificacion: LocalDateTime
  }

  interface IApiExternaAdapter {
    +obtenerTodosLosHechos(): List<Hecho>
    +verificarConexion(): boolean
  }

  class OngApiAdapter implements IApiExternaAdapter {
    -webClient: WebClient
    -accessToken: String
    -tokenType: String
    -perPage: Integer
    -authHeader: String
    -authHeaderValue: String
    -email: String
    -password: String
    +obtenerTodosLosHechos(): List<Hecho>
    +verificarConexion(): boolean
    -inicializar(): void
    -autenticar(): void
    -obtenerHechosDesdeApi(): List<HechoProxyDTO>
    -obtenerPagina(int): HechoProxyResponseDTO
    -convertirDtosADominio(List<HechoProxyDTO>): List<Hecho>
    -convertirDtoADominio(HechoProxyDTO): Hecho
  }

  IApiExternaAdapter ..> Hecho

@enduml

