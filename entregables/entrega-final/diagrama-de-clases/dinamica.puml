@startuml

' Entidades del dominio Hecho

class Hecho {
-id: Long
-fechaDeCarga: LocalDateTime
-origen: OrigenHecho
-enviado: Boolean
-solicitud: SolicitudHecho
+toOutputDTO(): HechoOutputDTO
}

Hecho --> OrigenHecho
enum OrigenHecho {
ANONIMO
CONTRIBUYENTE
}

Hecho --> SolicitudHecho

' Entidades del dominio Solicitud

class SolicitudHecho {
-id: Long
-idContribuyente: Long
-titulo: String
-descripcion: String
-categoria: String
-latitud: Double
-longitud: Double
-fechaDeAcontecimiento: LocalDateTime
-multimedia: List<ContenidoMultimedia>
-fechaDeCargaSolicitud: LocalDateTime
-estado: EstadoSolicitud
-transiciones: List<TransicionEstadoSolicitud>
+cambiarEstado(EstadoSolicitud): void
+esAnonimo(): boolean
+validarModificacionPorUsuario(Long): void
+validarCoordenadas(): void
+validarFechaNoFutura(): void
+toOutputDTO(): SolicitudOutputDTO
}

SolicitudHecho --> EstadoSolicitud
enum EstadoSolicitud {
PENDIENTE
ACEPTADO
ACEPTADO_MODIFICADO
RECHAZADO
}

SolicitudHecho -->"*" ContenidoMultimedia
class ContenidoMultimedia {
-id: Long
-pathArchivo: String
-tipoContenido: TipoContenido
-solicitudHecho: SolicitudHecho
+toOutputDTO(): ContenidoMultimediaOutputDTO
}

ContenidoMultimedia --> TipoContenido
enum TipoContenido {
AUDIO
IMAGEN
VIDEO
}

SolicitudHecho -->"*" TransicionEstadoSolicitud
class TransicionEstadoSolicitud {
-id: Long
-estado: EstadoSolicitud
-fecha: LocalDateTime
}


@enduml