@startuml
entity "HECHO" as h {
id: INT<<PK>>
coleccion_handle: UUID2 <<FK>>
titulo: VARCHAR(255)
descripcion: VARCHAR(255)
latitud: FLOAT
longitud: FLOAT
fechaDeAcontecimiento: DATE
fechaDeCarga: DATE
origen: ENUM
estado: ENUM
contribuyente_id: INT<<FK>>
categoria_id: INT<<FK>>

}

entity "CONTRIBUYENTE" as cont {
id: INT<<PK>>
nombre: VARCHAR(255)
apellido: VARCHAR(255)
fechaDeNacimiento: DATE
}

entity "CATEGORIA" as cat {
id: INT<<PK>>
nombre: VARCHAR(255)
}

entity "MULTIMEDIA" as multi {
id: INT<<PK>>
hecho_id: INT <<FK>>
nombre: VARCHAR(255)
tipoContenid: ENUM
}

entity "COLECCION" as col {
handle: UUID2<<PK>>
titulo: VARCHAR(255)
descripcion: VARCHAR(255)
algoritmo_id: INT<<FK>>
criterio_id: INT<<FK>>
}

entity "COLECCION_CRITERIO" as crit {
id: INT<<PK>>
}

entity "CRITERIO_COMBINADO" as comn {
id: INT<<PK>>
}

entity "CRITERIO_FECHAS" as fech {
id: INT<<PK>>
fechaInicial: DATE
fechaFinal: DATE
tipoFecha: ENUM
}


entity "CRITERIO_FUENTE" as fuent {
id:INT<<PK>>
idService: INT
}

entity "CRITERIO_IGUALDAD" as igual {
id: INT<<PK>>
cadenaAComparar: VARCHAR(255)
tipoDato: ENUM
}

entity "CRITERIO_LUGAR" as lug {
id: INT<<PK>>
lat: FLOAT
lng: FLOAT
}

entity "CRITERIO_ORIGEN" as orig {
id: INT<<PK>>
origenHecho: ENUM
}

entity "COLECCION_ALGORITMO" as alg {
id: INT<<PK>>
}

entity "ABSOLUTA" as abs {
id: INT<<PK>>
}

entity "MAYORIA_SIMPLE" as ms {
id: INT<<PK>>
}

entity "MULTIPLES_MENCIONES" as mm {
id: INT<<PK>>
}

entity "SOLICITUD_ELIMINACION" as se {
id: INT<<PK>>
id_hecho: INT<<FK>>
textoFundamentos: TEXT
fecha: DATE
estadoSolicitud: ENUM
id_contribuyente: INT<<FK>>
}


col ||--|{ h
col ||--o| alg
col ||--|| crit
h ||--o{ multi
h ||--|| cat
h ||--|| cont
alg <|--abs
alg <|--ms
alg <|-- mm
cont ||--o{ se
h ||--o{ se
crit <|--|| comn
crit <|--|| fech
crit <|--|| fuent
crit <|--|| igual
crit <|--|| lug
crit <|--|| orig

@enduml