@startuml

entity "HECHO" as h {
id: INT <<PK>>
fecha_carga: DATETIME
origen: ENUM
enviado: BOOLEAN
solicitud_id: INT <<FK>>
}

entity "SOLICITUD_HECHO" as sh {
id: INT <<PK>>
id_contribuyente: INT
titulo: VARCHAR(255)
descripcion: TEXT
categoria: VARCHAR(255)
latitud: DOUBLE
longitud: DOUBLE
fecha_de_acontecimiento: DATETIMETIME
fecha_de_carga_solicitud: DATETIME
estado: ENUM
}

entity "CONTENIDO_MULTIMEDIA" as cm {
id: INT <<PK>>
solicitud_id: INT <<FK>>
path: VARCHAR(255)
tipo_contenido: ENUM
}

entity "TRANSICION_ESTADO_SOLICITUD" as tes {
id: INT <<PK>>
solicitud_id: INT <<FK>>
estado: ENUM
fecha: DATETIME
}

h ||--|| sh
sh ||--o{ cm
sh ||--o{ tes

@enduml

