@startuml

entity "ARCHIVO" as archivo {
id: INT <<PK>>
nombre: VARCHAR(255)
procesado: BOOLEAN
}

entity "HECHO" as hecho {
id: INT <<PK>>
titulo: VARCHAR(255)
descripcion: TEXT
categoria: VARCHAR(255)
latitud: DOUBLE
longitud: DOUBLE
fecha_de_acontecimiento: DATE
fecha_carga: DATETIME
origen: ENUM
enviado: BOOLEAN
}

@enduml

