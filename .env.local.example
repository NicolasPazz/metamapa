# ============================================
# Archivo de ejemplo para variables de entorno LOCAL
# ============================================
# Copia este archivo a .env.local y completa con tus valores reales
#
# Uso: cp .env.local.example .env.local

# ============================================
# Base de Datos MySQL Local
# ============================================
# ContraseÃ±a del usuario root de MySQL
DB_PASSWORD=ejemplo_password_mysql_local

# Puerto externo de MySQL (por defecto 3308 para evitar conflictos con MySQL de Windows)
DB_PORT=3308

# ============================================
# ConfiguraciÃ³n de Base de Datos
# ============================================
# Estrategia de DDL de Hibernate (update, validate, create, create-drop)
# Para desarrollo local, normalmente se usa 'update'
DDL_AUTO=update

# ============================================
# Servicio Users
# ============================================
# Credenciales del usuario administrador inicial
ADMIN_USERNAME=admin_ejemplo
ADMIN_PASSWORD=password_admin_ejemplo_seguro

# ============================================
# Servicio Proxy ONG
# ============================================
# Credenciales para autenticaciÃ³n con la API externa de ONG
PROXY_ONG_EMAIL=ejemplo@email.com
PROXY_ONG_PASSWORD=password_ong_ejemplo
PROXY_ONG_API_URL=https://api-ejemplo.disilab.ar/public/api