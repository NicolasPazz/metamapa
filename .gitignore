# =============================================================================
# 1. ARCHIVOS DE COMPILACIoN Y BUILD
# =============================================================================

# Directorios de compilacion Maven
target/
**/target/
!.mvn/wrapper/maven-wrapper.jar
!.mvn/wrapper/maven-wrapper.properties

# Archivos compilados Java
**/*.class

# Directorios de build genericos
build/
!**/src/main/**/build/
!**/src/test/**/build/

# =============================================================================
# 2. ARCHIVOS DE IDEs Y EDITORES
# =============================================================================

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/

# =============================================================================
# 3. ARCHIVOS DE CONFIGURACIoN Y ENTORNO
# =============================================================================

.env
.env.local
.env.prod
.env.*.local
!.env*.example

# =============================================================================
# 4. ARCHIVOS DE DATOS Y CONTENIDO GENERADO POR USUARIOS
# =============================================================================

backend/data/csv/**
backend/data/multimedia/**
!backend/data/
!backend/data/csv/
!backend/data/multimedia/

# =============================================================================
# 5. ARCHIVOS DE DOCUMENTACIoN
# =============================================================================

**/*.md
!README.md

